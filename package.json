{
  "name": "dsh-git-branch-graph",
  "version": "1.3.0",
  "description": "Docked multi-project Git branch graph for DeepSeek Harness, with a safe repository creation wizard and local GitHub/Gitee credentials.",
  "license": "MIT",
  "author": "DannielZhang",
  "homepage": "https://github.com/DannielZhang/dsh-git-branch-graph",
  "repository": {
    "type": "git",
    "url": "https://github.com/DannielZhang/dsh-git-branch-graph.git"
  },
  "bugs": {
    "url": "https://github.com/DannielZhang/dsh-git-branch-graph/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "git",
    "branch",
    "graph",
    "repository"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./projection": "./projection.js",
    "./git": "./git.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "projection.js",
    "git.js",
    "repo.js",
    "remote.js",
    "credentials.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "market",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check projection.js && node --check git.js && node --check repo.js && node --check remote.js && node --check credentials.js && node --check client.js && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
